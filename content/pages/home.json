    {
      "type": "faq",
      "enabled": true,
      "section_name": "Questions that often hold businesses back from taking the next step.",
      "visual_preset": "standard",
      "content": {
        "eyebrow": "Before You Get Started",
        "heading": "Questions that often hold businesses back from taking the next step.",
        "items": [
          {
            "question": "How much does it cost?",
            "answer": "Pricing depends on scope, channels and the level of execution required. We recommend a focused first step after reviewing your current growth system."
          },
          {
            "question": "Do you work with small businesses?",
            "answer": "Yes, when there is a clear commercial goal, realistic budget and enough demand to build a measurable growth plan."
          },
          {
            "question": "Do you offer one-off projects?",
            "answer": "Yes. Audits, tracking implementations, landing pages, websites and focused strategy projects can be scoped independently."
          },
          {
            "question": "Do I need a long-term contract?",
            "answer": "Not always. The right engagement model depends on the work."
          },
          {
            "question": "Can you manage our existing Google or Meta accounts?",
            "answer": "Yes. We can audit and improve existing accounts rather than rebuilding everything unnecessarily."
          },
          {
            "question": "Can you fix GA4 and GTM tracking?",
            "answer": "Yes. Analytics and conversion tracking are core parts of the growth system."
          },
          {
            "question": "Do you only work with Australian businesses?",
            "answer": "No. Benvor Digital works with businesses in Australia and internationally."
          },
          {
            "question": "How quickly can we start?",
            "answer": "After access, scope and priorities are confirmed, focused audits and implementation work can usually begin quickly."
          }
        ]
      },
